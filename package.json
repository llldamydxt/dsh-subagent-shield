{
  "name": "dsh-subagent-shield",
  "version": "0.8.9",
  "private": true,
  "description": "子代理信息隔断：禁止子代理读取父会话/兄弟会话的落盘记录、投影缓存与凭据文件；带设置页配置卡与可拖动状态小窗",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT"
}
